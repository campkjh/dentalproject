# Supabase ------------------------------------------------------------------
# Get these from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (do NOT expose to the browser). Used for seed scripts and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used in OAuth redirect callbacks (e.g. https://kidoctor.app or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Naver Maps (NCP) — 지도 표시 + 주소→좌표 변환
# Client ID는 공개값(지도 스크립트 ncpKeyId), Secret은 서버 전용(Geocoding)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Toss Payments — 일반결제(단건) 결제창 (API 개별 연동 키)
# 토스 개발자센터 > 내 상점 > API 키 에서 발급. 클라이언트키는 공개값, 시크릿키는 서버 전용.
# 로컬 테스트는 토스 공개 문서 테스트키 사용 가능:
#   NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
#   TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# PortOne 본인인증 (NHN KCP) — 휴대폰 본인인증(PASS·통신 3사·알뜰폰)으로 만 19세 이상만 이용
# 아래 4개가 모두 채워지고 REQUIRED=true 일 때만 인증을 요구한다 — 로그인한 고객의 화면 전체와 예약·상담·글·댓글·후기 작성(하나라도 비면 요구하지 않음).
# REQUIRED=true 는 실기기 E2E(PC·모바일 웹, iOS·Android 앱)를 마친 뒤에만 켠다 — 순서는 SETUP.md '8. 본인인증(만 19세 이상) 켜기'.
IDENTITY_VERIFICATION_REQUIRED=false
# 서버 전용. 포트원 콘솔 > 결제 연동 > 연동 정보 > 식별코드·API Keys > V2 API 의 V2 Secret.
# V2 Secret 은 만료일이 있다 — 만료일을 일정에 적어 두고 그 전에 재발급·교체(만료되면 인증 확인이 전부 실패).
PORTONE_API_SECRET=
# 아래 두 값은 공개값(NEXT_PUBLIC_*) — 브라우저에 노출되고 빌드 때 번들에 박히므로 바꾸면 반드시 재배포.
# 같은 화면(V2 API)의 상점 아이디(Store ID, store-…)
NEXT_PUBLIC_PORTONE_STORE_ID=
# 결제 연동 > 연동 정보 > 채널 관리 > NHN KCP '본인인증' 속성 채널의 채널 키(channel-key-…). 결제 채널 키와 다르다.
NEXT_PUBLIC_PORTONE_IDV_CHANNEL_KEY=
# (선택) 본인인증 시작 쿠키 서명 키. 비우면 SUPABASE_SERVICE_ROLE_KEY 로 서명한다.
IDENTITY_COOKIE_SECRET=
# (선택) 테스트 채널로 끝난 인증을 받아들일지. 운영과 다른 DB를 쓰는 로컬·프리뷰에서만 true.
IDENTITY_ALLOW_TEST_CHANNEL=false

# Public company/legal display values -------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME=(주)키닥터
NEXT_PUBLIC_COMPANY_REPRESENTATIVE=
NEXT_PUBLIC_COMPANY_BUSINESS_NUMBER=
NEXT_PUBLIC_COMPANY_MAIL_ORDER_NUMBER=
NEXT_PUBLIC_COMPANY_POSTAL_CODE=
NEXT_PUBLIC_COMPANY_ADDRESS=서울특별시 금천구 가산디지털1로 225, 11층 1123-에이-2호
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COPYRIGHT_NAME=키닥터
